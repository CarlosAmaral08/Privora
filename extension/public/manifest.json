{
  "manifest_version": 3,
  "key": "",
  "name": "Privora",
  "description": "Torne políticas de privacidade mais claras e compreensíveis.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://privora.zapeu.net/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir Privora",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/privora-16.png",
      "32": "icons/privora-32.png",
      "48": "icons/privora-48.png",
      "128": "icons/privora-128.png"
    }
  },
  "icons": {
    "16": "icons/privora-16.png",
    "32": "icons/privora-32.png",
    "48": "icons/privora-48.png",
    "128": "icons/privora-128.png"
  }
}
